{
  "version": 2,
  "id": "expense-approval",
  "title": "一笔报销，怎样走到入账",
  "notice": "业务机制示例 · 非任何公司的实际审批制度",
  "playback": {
    "mode": "presentation",
    "end": "loop",
    "selector": true
  },
  "actors": [
    {
      "id": "employee",
      "label": "员工",
      "kind": "message"
    },
    {
      "id": "request",
      "label": "报销单",
      "kind": "group"
    },
    {
      "id": "manager",
      "label": "负责人",
      "kind": "service"
    },
    {
      "id": "finance",
      "label": "财务",
      "kind": "service"
    },
    {
      "id": "receipt",
      "label": "入账回执",
      "kind": "message"
    }
  ],
  "relations": [
    {
      "id": "submit",
      "from": "employee",
      "to": "request",
      "kind": "message",
      "label": "提交",
      "requires": [
        "submitted"
      ],
      "produces": [
        "received"
      ]
    },
    {
      "id": "review",
      "from": "request",
      "to": "manager",
      "kind": "dependency",
      "label": "待审批"
    },
    {
      "id": "approve",
      "from": "manager",
      "to": "finance",
      "kind": "message",
      "label": "审批通过",
      "requires": [
        "approved"
      ],
      "produces": [
        "finance-ready"
      ]
    },
    {
      "id": "archive",
      "from": "finance",
      "to": "receipt",
      "kind": "return",
      "label": "入账成功",
      "requires": [
        "booked"
      ],
      "produces": [
        "notified"
      ]
    }
  ],
  "contract": {
    "sources": [
      {
        "id": "source",
        "reference": "Illustrative assumption authored for this example; not a production policy.",
        "scope": "只有负责人明确批准后，财务才可入账；本示例不包含驳回或付款。"
      }
    ],
    "facts": [
      {
        "id": "submitted",
        "description": "员工提交报销单",
        "origin": "external",
        "after": [],
        "source": "source"
      },
      {
        "id": "received",
        "description": "系统收到报销单",
        "origin": "flow",
        "after": [
          "submitted"
        ],
        "source": "source"
      },
      {
        "id": "approved",
        "description": "负责人明确批准",
        "origin": "external",
        "after": [
          "received"
        ],
        "source": "source"
      },
      {
        "id": "finance-ready",
        "description": "财务收到批准结果",
        "origin": "flow",
        "after": [
          "approved"
        ],
        "source": "source"
      },
      {
        "id": "booked",
        "description": "财务完成入账",
        "origin": "external",
        "after": [
          "finance-ready"
        ],
        "source": "source"
      },
      {
        "id": "notified",
        "description": "员工收到入账回执",
        "origin": "flow",
        "after": [
          "booked"
        ],
        "source": "source"
      }
    ],
    "rules": [
      {
        "id": "review-after-receive",
        "type": "requires",
        "actor": "manager",
        "states": [
          "active",
          "done"
        ],
        "facts": [
          "received"
        ]
      },
      {
        "id": "book-after-approval",
        "type": "requires",
        "actor": "finance",
        "states": [
          "active",
          "done"
        ],
        "facts": [
          "approved",
          "finance-ready"
        ]
      },
      {
        "id": "receipt-after-booking",
        "type": "requires",
        "actor": "receipt",
        "states": [
          "active",
          "done"
        ],
        "facts": [
          "notified"
        ]
      }
    ]
  },
